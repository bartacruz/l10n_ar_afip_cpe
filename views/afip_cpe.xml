<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="cpe_view_tree" model="ir.ui.view">
        <field name="name">afip.cpe.view.tree</field>
        <field name="model">afip.cpe</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="name" />
                <field name="order_number" optional="hide"/>
                <field name="origin_number" optional="hide"/>
                <field name="customer_id" optional="show"/>
                <field name="origin_partner_id" optional="show"/>
                <field name="origin_id" optional="hide"/>
                <field name="origin_locality_id" optional="show"/>
                <field name="destination_id" optional="hide"/>
                <field name="destination_locality_id" optional="show"/>
                <field name="destination_partner_id" optional="hide"/>
                <field name="drivers" />
                <field name="license_plates" />
                <field name="unload_net" optional="show"/>
                <field name="status" />
                

            </tree>
        </field>
    </record>
    <record id="cpe_view_form" model="ir.ui.view">
        <field name="name">afip.cpe.view.form</field>
        <field name="model">afip.cpe</field>
        <field name="arch" type="xml">
            <form string="Carta de Porte Granario">
                <header>
                    <button
                        name="action_update_cpe"
                        type="object"
                        string="Actualizar"
                        class="btn btn-primary text-uppercase"
                    />
                    <field
                        name="status"
                        widget="statusbar"
                        options="{'clickable':True}"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"></div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        
                        <group>
                            <field name="customer_id" string="Cliente"/>    
                            <field name="origin_partner_id" string="Titular"/>
                            <field name="origin_code" string="Planta" invisible="origin_code == 0"/>
                            <field name="origin_id" invisible="not origin_id" readonly="True" widget="res_partner_many2one" context="{'show_address': 1, 'show_vat': False}"/>
                            <field name="origin_locality_id" />
                            <field name="origin_city" string="Ciudad" invisible="origin_id" />
                            <field name="origin_state_id" string="Provincia" invisible="origin_id" />
                            
                            <field name="destination_partner_id" string="Destinatario"/>
                            <field name="destination_code" string="Planta" invisible="destination_code == 0"/>
                            <field name="destination_id" invisible="not destination_id" readonly="True" widget="res_partner_many2one" context="{'show_address': 1, 'show_vat': False}"/>
                            <field name="destination_locality_id" />
                            <field name="destination_city" string="Ciudad" invisible="destination_id" />
                            <field name="destination_state_id" string="Provincia" invisible="destination_id" />
                            
                        </group>
                        <group>
                            <field name="ctg_number" />
                            <field name="origin_number" />
                            <field name="order_number" />
                            
                            <field name="emmited_date" />
                            <field name="status_date" />
                            <field name="due_date" />
                            <field name="load_net" string="Carga Neta"/>
                            <field name="unload_net" string="Descarga Neta"/>
                            
                        </group>
                        <label for="observations" class="oe_edit_only" string="Observaciones" />
                        <field string="Observaciones" name="observations" />
                    </group>
                    <notebook>
                        <page name="transports" string="Transports">
                            <field name="transport_ids">
                                <tree>
                                    <field name="start_date" />
                                    <field name="driver_id" />
                                    <field name="vehicle_id" />
                                    <field name="trailer_id" />
                                    <field name="distance" />
                                    <field name="price" />

                                </tree>
                            </field>
                        </page>
                        <page name="xml" string="XML">
                            <field name="afip_xml_response" />
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>
    <record id="view_afip_cpe_search" model="ir.ui.view">
        <field name="name">afip.cpe.search</field>
        <field name="model">afip.cpe</field>
        <field name="arch" type="xml">
            <search>
                <filter name="active" string="Activadas" domain="[('status', '=', 'AC')]" />
                <filter name="confirmed" string="Confirmadas" domain="[('status', '=', 'CN')]" />
                <filter name="confirmed" string="No confirmadas" domain="[('status', '!=', 'CN')]" />
                <filter name="voided" string="Anuladas" domain="[('status', '=', 'AN')]" />
                <filter name="rejected" string="Rechazadas" domain="[('status', '=', 'RE')]" />
                <field name="ctg_number" string="Nro CTG" />
                <field name="participants_ids" string="Participantes" />
                <field name="customer_id" string="Cliente" />
                <field name="drivers" string='Conductor' />
                <field name="origin_number" string="Origen" />
                <field name="order_number" string="Nro orden" />

            </search>
        </field>
    </record>

    <record id="action_afip_cpe_view" model="ir.actions.act_window">
        <field name="name">CPE</field>
        <field name="res_model">afip.cpe</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>